{
  "buildCommand": "npm run verify:release && npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/:path((?!.*\\.).*)*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/:path((?!.*\\.).*)*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/app-version.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": true,
      "*": false
    }
  }
}
